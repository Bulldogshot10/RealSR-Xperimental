<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="18dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/video_upscale_title"
            android:textAppearance="?attr/textAppearanceHeadline5"
            android:paddingBottom="8dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/video_upscale_description"
            android:paddingBottom="16dp" />

        <Button
            android:id="@+id/btn_select_video"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/video_select" />

        <TextView
            android:id="@+id/tv_video_selected"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/video_no_input"
            android:paddingTop="8dp"
            android:paddingBottom="16dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/video_model_label"
            android:paddingBottom="4dp" />

        <Spinner
            android:id="@+id/spinner_video_model"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/video_scale_label"
            android:paddingTop="14dp"
            android:paddingBottom="4dp" />

        <Spinner
            android:id="@+id/spinner_video_scale"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <Button
            android:id="@+id/btn_start_video"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="@string/video_start" />

        <Button
            android:id="@+id/btn_cancel_video"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/video_cancel"
            android:visibility="gone" />

        <ProgressBar
            android:id="@+id/video_progress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:indeterminate="true"
            android:visibility="gone"
            android:paddingTop="12dp" />

        <TextView
            android:id="@+id/tv_video_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/video_ready"
            android:paddingTop="12dp"
            android:paddingBottom="10dp" />

        <TextView
            android:id="@+id/tv_video_output"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:autoLink="web"
            android:paddingBottom="12dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/video_note"
            android:textSize="12sp"
            android:alpha="0.8" />

    </LinearLayout>
</ScrollView>
